# Server
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000,http://localhost:4000

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/time2work

# JWT
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Auth hybrid — mock OTP 123456 when MOCK_OTP=true (default in development)
MOCK_OTP=true

# Firebase phone auth (prod). Set FIREBASE_ENABLED=true and provide credentials.
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Or path to a service account JSON:
# GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# Payments hybrid — mock checkout when PAYMENTS_MODE=mock
PAYMENTS_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# FCM (optional). Without a key, notifications stay in-app / logged.
FCM_SERVER_KEY=
# FIREBASE_ENABLED also enables FCM via firebase-admin if users have tokens.

# Google Maps — Places Autocomplete + Geocoding (optional; Nominatim fallback when empty)
GOOGLE_MAPS_API_KEY=

# Uploads
UPLOAD_DIR=uploads
PUBLIC_URL=http://localhost:4000
